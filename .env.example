APP_NAME=Family Health Agent API
APP_VERSION=0.1.0
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
DEMO_USER_PHONE=13800000001

POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=family_health
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hospital:hospital@localhost:5432/family_health

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Keyword retrieval is always available. Enable only after injecting a vector backend.
RAG_VECTOR_ENABLED=false

# Model Gateway defaults to an offline deterministic provider.
MODEL_PROVIDER=deterministic
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=deterministic-local
MODEL_TIMEOUT_MS=10000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
