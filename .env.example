APP_NAME=Family Health Agent API
APP_VERSION=0.1.0
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
DEMO_USER_PHONE=13800000001

POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=family_health
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hospital:hospital@localhost:5432/family_health

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Keyword retrieval is always available. The deterministic vector provider is
# offline and test-friendly; switch provider to fastembed for semantic vectors.
RAG_VECTOR_ENABLED=true
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL=deterministic-hash-v1
RAG_EMBEDDING_DIMENSIONS=512
# Keep the optional FastEmbed model cache on the project/data disk.
FASTEMBED_CACHE_PATH=E:\\project_code\\hospital\\var\\fastembed

# Model Gateway defaults to an offline deterministic provider.
MODEL_PROVIDER=deterministic
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=deterministic-local
MODEL_THINKING_MODE=default
MODEL_TIMEOUT_MS=10000
# Optional 4D-B3 cost calculation. Leave blank when pricing is unknown.
MODEL_INPUT_PRICE_PER_1M_USD=
MODEL_OUTPUT_PRICE_PER_1M_USD=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
