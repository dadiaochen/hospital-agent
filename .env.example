APP_NAME=Family Health Agent API
APP_VERSION=0.1.0
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
DEMO_USER_PHONE=13800000001

POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=family_health
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hospital:hospital@localhost:5432/family_health

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Keyword retrieval is always available. The deterministic vector provider is
# offline and test-friendly; switch provider to fastembed for semantic vectors.
RAG_VECTOR_ENABLED=true
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL=deterministic-hash-v1
RAG_EMBEDDING_DIMENSIONS=512
# Optional local FastEmbed device: cpu (default), cuda, or auto.
RAG_EMBEDDING_DEVICE=cpu
# Keep the optional FastEmbed model cache on the project/data disk.
FASTEMBED_CACHE_PATH=E:\\project_code\\hospital\\var\\fastembed

# Target answer model used by the business chain. Model Gateway defaults to an
# offline deterministic provider, so local tests do not require a real key.
MODEL_PROVIDER=deterministic
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=deterministic-local
MODEL_THINKING_MODE=default
MODEL_TIMEOUT_MS=10000
# Optional 4D-B3 cost calculation. Leave blank when pricing is unknown.
MODEL_INPUT_PRICE_PER_1M_USD=
MODEL_OUTPUT_PRICE_PER_1M_USD=

# Independent offline RAGAS Judge. This block has its own Base URL, API Key and
# model name, and never affects the online business chain. The same provider
# account may be reused, but RAGAS_JUDGE_MODEL must differ from MODEL_NAME.
RAGAS_ENABLED=false
RAGAS_VERSION=0.2.9
RAGAS_JUDGE_API_BASE=
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_MODEL=
# Qwen-compatible endpoints generally use enable_thinking=false when disabled.
RAGAS_JUDGE_THINKING_MODE=disabled
RAGAS_EMBEDDING_PROVIDER=fastembed
RAGAS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAGAS_BATCH_SIZE=16
RAGAS_MAX_WORKERS=8
RAGAS_TIMEOUT_SECONDS=60

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
